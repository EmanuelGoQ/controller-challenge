# Copiar este archivo a ".env" y completar con los valores reales de tu cuenta de AWS.
# NUNCA subir el archivo ".env" real al repositorio (ya está en .gitignore).

AWS_REGION=us-east-1

# ARN del Target Group del ALB donde se registran/desregistran las instancias web
TARGET_GROUP_ARN=arn:aws:elasticloadbalancing:us-east-1:123456789012:targetgroup/webservers-tg/xxxxxxxxxxxxxxxx

# ID del Launch Template usado para crear nuevas instancias web (INCREASE_CAPACITY)
LAUNCH_TEMPLATE_ID=lt-0123456789abcdef0

# Tag usado para identificar las instancias administradas por el controlador
INSTANCE_TAG_KEY=Role
INSTANCE_TAG_VALUE=webserver

# Subred donde se lanzan nuevas instancias (debe estar asociada al Target Group / ALB)
SUBNET_ID=subnet-0123456789abcdef0

# Security Group de las instancias web
SECURITY_GROUP_ID=sg-0123456789abcdef0
